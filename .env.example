# AI Student Assistant — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to git — it is listed in .gitignore.

# ── Required: AI API Key ─────────────────────────────────────────────────
# Your API key from your AI provider (e.g. OpenAI, Azure, or compatible).
AI_API_KEY=your_api_key_here

# ── Optional: API Base URL ───────────────────────────────────────────────
# Default is OpenAI. Change this to use a different provider.
# Examples:
#   OpenAI (default): https://api.openai.com/v1
#   Azure OpenAI:     https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
#   Local (Ollama):   http://localhost:11434/v1
AI_API_BASE_URL=https://api.openai.com/v1

# ── Optional: Model Name ─────────────────────────────────────────────────
# Default is gpt-4o-mini (fast and cost-effective).
# Other options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
AI_MODEL=gpt-4o-mini

# ── Optional: Flask Settings ─────────────────────────────────────────────
# Set to "true" to enable Flask debug mode (development only).
FLASK_DEBUG=false

# Port to run the application on (default: 5000).
PORT=5000
